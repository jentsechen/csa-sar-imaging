/build/
# third-party clone (github.com/rogersce/cnpy), see README build steps
/cnpy/
/.vscode/*.json

__pycache__/
*.pyc

/TestImagingPar/*.json
/TestImagingPar/*.npy
/TestImagingPar/*.mat

/TestChirpScalingAlgo/*.html
/TestChirpScalingAlgo/result/
/TestChirpScalingAlgo/golden/

/TestMultiPointTarget/iter_result*
/TestMultiPointTarget/echo_signal/*.npy
/TestMultiPointTarget/focused_image/*.npy
/TestMultiPointTarget/focused_image/*.html
/TestMultiPointTarget/point_target_location/*.json
/TestMultiPointTarget/*.html
/TestMultiPointTarget/*.json
/TestMultiPointTarget/*.png

/gen_raw_data/*.png
/UmbraDataProc/*.tif
/UmbraDataProc/*.png
/UmbraDataProc/*.json

/venv/
/document/02_simulation_report/*
!/document/02_simulation_report/*.tex
!/document/02_simulation_report/*.pdf
!/document/02_simulation_report/.latexmkrc
!/document/02_simulation_report/*.md

# Personal meetings: one YYYY-MM-DD folder per meeting; track sources, PDFs, latexmkrc and figures
/document/03_personal_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*
!/document/03_personal_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*.tex
!/document/03_personal_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*.pdf
!/document/03_personal_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/.latexmkrc
!/document/03_personal_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/figures/

/document/04_group_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*
!/document/04_group_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*.tex
!/document/04_group_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*.pdf
!/document/04_group_meeting/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/.latexmkrc

/document/05_industry_academia_collaboration/*/*
!/document/05_industry_academia_collaboration/*/*.tex
!/document/05_industry_academia_collaboration/*/*.pdf
!/document/05_industry_academia_collaboration/*/.latexmkrc
!/document/05_industry_academia_collaboration/*/figures/

# MOE scholarship application: track sources, PDFs, figures, Makefile; ignore LaTeX build files
/document/06_moe_scholarship/**/*.aux
/document/06_moe_scholarship/**/*.log
/document/06_moe_scholarship/**/*.out
/document/06_moe_scholarship/**/*.fls
/document/06_moe_scholarship/**/*.fdb_latexmk
/document/06_moe_scholarship/**/*.synctex.gz

/ship_detect/results/
/ship_detect/test_data/
!.gitkeep

*.pt
*.bkp
*.dtmp

end_to_end_pipeline/images
end_to_end_pipeline/labels
end_to_end_pipeline/original_eval
# YOLO eval sets (symlinks + labels.cache + val runs) built by eval_union_csa*.py
end_to_end_pipeline/*_union_eval/
end_to_end_pipeline/union_masked
end_to_end_pipeline/union_masked_eval
end_to_end_pipeline/union_pipeline

end_to_end_pipeline/single_point_target/echo_signal/*.npy
end_to_end_pipeline/single_point_target/focused_image/*.npy
# Speckle sweep (sarsim/speckle_pipeline.py): ~7 GB of JPGs, YOLO eval sets and raw logs are
# regenerable; the small summaries (split, chosen params, tune/results tables, variance,
# speckle stats, per-scene detections, figures, run_all.sh) are tracked
end_to_end_pipeline/speckle/*/tune/
end_to_end_pipeline/speckle/*/test/
end_to_end_pipeline/speckle/*/_eval/
end_to_end_pipeline/speckle/*/timing.csv
end_to_end_pipeline/speckle/*/*.log

# Thermal-noise sweep (sarsim/noise_pipeline.py): same policy as the speckle sweep
end_to_end_pipeline/noise/*/tune/
end_to_end_pipeline/noise/*/test/
end_to_end_pipeline/noise/*/_eval/
end_to_end_pipeline/noise/*/timing.csv
end_to_end_pipeline/noise/*/*.log

# Derivation notes: track sources, PDFs and README; ignore LaTeX build files
/document/01_derivations/*
!/document/01_derivations/*.tex
!/document/01_derivations/*.pdf
!/document/01_derivations/README.md
