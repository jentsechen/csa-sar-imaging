# MOE scholarship application: track sources, PDFs, figures, Makefile; ignore LaTeX build files
/document/moe_scholarship/**/*.aux
/document/moe_scholarship/**/*.log
/document/moe_scholarship/**/*.out
/document/moe_scholarship/**/*.fls
/document/moe_scholarship/**/*.fdb_latexmk
/document/moe_scholarship/**/*.synctex.gz

/ship_detect/results/
/ship_detect/test_data/
!.gitkeep

*.pt
*.bkp
*.dtmp

end_to_end_pipeline/images
end_to_end_pipeline/labels
end_to_end_pipeline/original_eval
# YOLO eval sets (symlinks + labels.cache + val runs) built by eval_union_csa*.py
end_to_end_pipeline/*_union_eval/
end_to_end_pipeline/union_masked
end_to_end_pipeline/union_masked_eval
end_to_end_pipeline/union_pipeline

end_to_end_pipeline/single_point_target/echo_signal/*.npy
end_to_end_pipeline/single_point_target/focused_image/*.npy
# Speckle sweep (sarsim/speckle_pipeline.py): ~7 GB of JPGs, YOLO eval sets and raw logs are
# regenerable; the small summaries (split, chosen params, tune/results tables, variance,
# speckle stats, per-scene detections, figures, run_all.sh) are tracked
end_to_end_pipeline/speckle/*/tune/
end_to_end_pipeline/speckle/*/test/
end_to_end_pipeline/speckle/*/_eval/
end_to_end_pipeline/speckle/*/timing.csv
end_to_end_pipeline/speckle/*/*.log
